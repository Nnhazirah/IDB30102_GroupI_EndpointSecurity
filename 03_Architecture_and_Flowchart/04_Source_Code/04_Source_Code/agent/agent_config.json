{
    "agent_name": "RansomwareDetectionAgent",
    "version": "0.1.0",
    "config": {
        "window_seconds": 10,
        "threshold": 0.7,
        "buffer_size": 500,
        "send_interval": 5,
        "backend_url": "http://localhost:8000/api/features"
    },
    "monitoring": {
        "enabled": true,
        "excluded_paths": ["C:\\Windows\\", "C:\\Program Files\\"],
        "included_paths": ["C:\\Users\\"]
    },
    "logging": {
        "level": "INFO",
        "file": "agent.log"
    }
}
